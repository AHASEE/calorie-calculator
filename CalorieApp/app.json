{
  "expo": {
    "name": "CalorieAI",
    "slug": "calorieai",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/icon.png",

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },

    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.calorieai",
      "infoPlist": {
        "NSCameraUsageDescription": "Khane ki photo lene ke liye",
        "NSPhotoLibraryUsageDescription": "Gallery se khane ki photo choose karne ke liye"
      }
    },

    "android": {
      "package": "com.yourname.calorieai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },

    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Gallery se khane ki photo lene ke liye",
          "cameraPermission": "Khane ki photo lene ke liye"
        }
      ]
    ]
  }
}