{
  "expo": {
    "name": "Alviva",
    "slug": "calorieai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "alviva",
    "owner": "haseeb121",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alviva.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Alviva to use your camera to scan meals and estimate nutrition.",
        "NSPhotoLibraryUsageDescription": "Allow Alviva to choose meal photos from your library for nutrition estimates."
      }
    },
    "android": {
      "package": "com.alviva.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Alviva to choose meal photos from your library for nutrition estimates.",
          "cameraPermission": "Allow Alviva to use your camera to scan meals and estimate nutrition."
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2de80a49-db14-4146-a187-100017a75511"
      }
    }
  }
}
